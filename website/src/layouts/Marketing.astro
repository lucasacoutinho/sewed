---
import "../styles/tokens.css";
import "../styles/marketing.css";

import ThemeProvider from "../components/ThemeProvider.astro";
import Footer from "../components/marketing/Footer.astro";
import Nav from "../components/marketing/Nav.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = Astro.site === undefined ? undefined : new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeProvider />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical.href} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sewed" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical.href} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="sw-root">
    <header class="sw-marketing-header">
      <Nav marketing />
    </header>
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
