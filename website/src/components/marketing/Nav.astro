---
import Search from "@astrojs/starlight/components/Search.astro";
import Logo from "./Logo.astro";

interface Props {
  /** Set on the marketing layout, where this nav is the only header and there is no drawer. */
  marketing?: boolean;
}

const { marketing = false } = Astro.props;
const repository = "https://github.com/lucasacoutinho/sewed";
---

<nav class:list={["sw-nav", { "sw-nav--docs": !marketing }]}>
  <a href="/" class="sw-nav__brand" aria-label="Sewed home">
    <Logo />
  </a>
  <div class="sw-nav__spacer"></div>
  <div class="sw-nav__search">
    <Search />
  </div>
  <a href="/getting-started/" class="sw-nav__link">Docs</a>
  <a href="/reference/" class="sw-nav__link">Reference</a>
  <a href={repository} class="sw-nav__link sw-nav__link--icon" aria-label="GitHub">
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
      <path
        d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.69-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.04 11.04 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.07.78 2.16 0 1.56-.01 2.81-.01 3.19 0 .31.21.67.8.56C20.71 21.39 24 17.08 24 12 24 5.73 18.27.5 12 .5z"
      ></path>
    </svg>
    <span class="sw-nav__link-text">GitHub</span>
  </a>
  <button
    type="button"
    class="sw-nav__theme-toggle"
    aria-label="Toggle color theme"
    title="Toggle color theme"
    data-theme-toggle
  >
    <svg
      class="sw-theme-icon sw-theme-icon--sun"
      aria-hidden="true"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path
        d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
      ></path>
    </svg>
    <svg
      class="sw-theme-icon sw-theme-icon--moon"
      aria-hidden="true"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"></path>
    </svg>
  </button>
</nav>

<style>
  .sw-nav,
  .sw-nav * {
    box-sizing: border-box;
  }
  .sw-nav {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .sw-nav__brand {
    text-decoration: none;
  }
  .sw-nav__spacer {
    flex: 1;
  }
  .sw-nav__search {
    display: flex;
    align-items: center;
    width: 220px;
  }
  .sw-nav__search :global(site-search) {
    display: block;
    width: 100%;
  }
  .sw-nav__search :global(button[data-open-modal]) {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    height: 32px;
    padding: 0 8px 0 12px;
    background: var(--sw-bg);
    border: 1px solid var(--sw-hairline-2);
    border-radius: 8px;
    font-size: 12px;
    color: var(--sw-fg-4);
    cursor: pointer;
    font-family: inherit;
  }
  .sw-nav__search :global(button[data-open-modal]:hover) {
    border-color: var(--sw-fg-4);
    color: var(--sw-fg-2);
  }
  .sw-nav__search :global(button[data-open-modal] svg) {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  .sw-nav__search :global(button[data-open-modal] > :last-child) {
    margin-inline-start: auto;
  }
  .sw-nav__search :global(button[data-open-modal] kbd) {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    background: transparent;
    border: 0;
    padding: 0;
    font-family: var(--sw-font-mono);
    font-size: 11px;
    color: var(--sw-fg-2);
  }
  .sw-nav__search :global(button[data-open-modal] kbd kbd) {
    background: var(--sw-bg-elev-1);
    border: 1px solid var(--sw-hairline-2);
    border-radius: 4px;
    padding: 1px 5px;
  }
  .sw-nav__theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid var(--sw-hairline-2);
    border-radius: 8px;
    background: transparent;
    color: var(--sw-fg-2);
    cursor: pointer;
    font: inherit;
    transition:
      color var(--sw-dur) var(--sw-ease),
      border-color var(--sw-dur) var(--sw-ease),
      background-color var(--sw-dur) var(--sw-ease);
  }
  .sw-nav__theme-toggle:hover {
    color: var(--sw-accent-deep);
    border-color: var(--sw-accent-40);
    background: var(--sw-bg-elev-1);
  }
  .sw-nav__theme-toggle:focus-visible {
    outline: 2px solid var(--sw-accent-40);
    outline-offset: 2px;
  }
  .sw-theme-icon {
    display: block;
  }
  .sw-theme-icon--sun {
    display: none;
  }
  :global([data-theme="dark"]) .sw-theme-icon--sun {
    display: block;
  }
  :global([data-theme="dark"]) .sw-theme-icon--moon {
    display: none;
  }
  .sw-nav__link {
    color: var(--sw-fg-2);
    text-decoration: none;
    font-size: 14px;
  }
  .sw-nav__link:hover {
    color: var(--sw-accent-deep);
  }
  .sw-nav__link--icon {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  @media (max-width: 880px) {
    .sw-nav__search {
      width: auto;
    }
    .sw-nav__search :global(button[data-open-modal]) {
      width: 32px;
      justify-content: center;
      padding: 0;
    }
    .sw-nav__search :global(button[data-open-modal] svg) {
      width: 16px;
      height: 16px;
    }
    .sw-nav__search :global(button[data-open-modal] > span),
    .sw-nav__search :global(button[data-open-modal] kbd) {
      display: none;
    }
    .sw-nav__link--icon .sw-nav__link-text {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .sw-nav {
      gap: 16px;
    }
    .sw-nav__link:not(.sw-nav__link--icon) {
      display: none;
    }
  }
  @media (max-width: 50rem) {
    .sw-nav--docs .sw-nav__link {
      display: none;
    }
  }
</style>

<style is:global>
  /* Starlight's search dialog renders in the top layer and expects its own tokens,
     which marketing pages do not load. Map them onto the Sewed palette. */
  site-search {
    --sl-color-white: var(--sw-fg-1);
    --sl-color-text: var(--sw-fg-1);
    --sl-color-text-accent: var(--sw-accent-deep);
    --sl-color-accent: var(--sw-accent);
    --sl-color-accent-high: var(--sw-accent-deep);
    --sl-color-accent-low: var(--sw-accent-12);
    --sl-color-gray-1: var(--sw-fg-1);
    --sl-color-gray-2: var(--sw-fg-2);
    --sl-color-gray-3: var(--sw-fg-3);
    --sl-color-gray-4: var(--sw-fg-4);
    --sl-color-gray-5: var(--sw-hairline-2);
    --sl-color-gray-6: var(--sw-bg-sunk);
    --sl-color-black: var(--sw-bg-elev-1);
    --sl-color-backdrop-overlay: rgba(35, 35, 32, 0.35);
    --sl-shadow-lg: 0 24px 64px rgba(35, 35, 32, 0.25);
    --__sl-font: var(--sw-font-sans);
  }
  site-search dialog {
    color: var(--sw-fg-2);
    border-radius: 12px;
    font-family: var(--sw-font-sans);
  }
  site-search dialog::backdrop {
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  site-search button[data-close-modal] {
    display: none;
    font-family: var(--sw-font-sans);
  }
  @media (max-width: 50rem) {
    site-search button[data-close-modal] {
      display: inline-flex;
      inset-inline-end: 1rem;
    }
  }
  site-search #starlight__search {
    --pagefind-ui-primary: var(--sw-fg-1);
    --pagefind-ui-text: var(--sw-fg-2);
    --pagefind-ui-background: var(--sw-bg-sunk);
    --pagefind-ui-border: var(--sw-hairline-2);
    --pagefind-ui-tag: var(--sw-bg-sunk);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-font: var(--sw-font-sans);
    --pagefind-ui-scale: 0.85;
  }
  site-search #starlight__search .pagefind-ui__search-input {
    color: var(--sw-fg-1);
    background: var(--sw-bg-elev-1);
    font-family: var(--sw-font-sans);
    border: 1px solid var(--sw-hairline-2);
    border-radius: 8px;
  }
  site-search #starlight__search input:focus {
    --pagefind-ui-border: var(--sw-accent);
    box-shadow: 0 0 0 3px var(--sw-accent-12);
  }
  site-search #starlight__search .pagefind-ui__result {
    background: var(--sw-bg-elev-1);
    border: 1px solid var(--sw-hairline);
    border-radius: 10px;
  }
  site-search #starlight__search .pagefind-ui__result-link {
    --pagefind-ui-text: var(--sw-fg-1);
    color: var(--sw-fg-1);
    font-weight: 600;
  }
  site-search #starlight__search .pagefind-ui__result-excerpt {
    color: var(--sw-fg-3);
  }
  site-search #starlight__search mark {
    color: var(--sw-accent-deep);
    background: transparent;
    font-weight: 700;
  }
</style>

<script is:inline>
  (() => {
    const button = document.querySelector("[data-theme-toggle]");
    if (!button) return;
    button.addEventListener("click", () => {
      const current = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
      const next = current === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem("starlight-theme", next);
      } catch {}
      if (window.StarlightThemeProvider) window.StarlightThemeProvider.updatePickers(next);
    });
  })();
</script>
