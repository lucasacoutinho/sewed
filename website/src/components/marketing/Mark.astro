---
/** The Sewed button mark: a stitched ring with four holes. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 22, class: className } = Astro.props;
---

<svg
  class={className}
  aria-hidden="true"
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
>
  <circle
    cx="16"
    cy="16"
    r="12.5"
    stroke="var(--sw-accent)"
    stroke-width="2.4"
    stroke-dasharray="3.2 2.6"
    stroke-linecap="round"></circle>
  <circle cx="12" cy="12" r="2" fill="var(--sw-fg-1)"></circle>
  <circle cx="20" cy="12" r="2" fill="var(--sw-fg-1)"></circle>
  <circle cx="12" cy="20" r="2" fill="var(--sw-fg-1)"></circle>
  <circle cx="20" cy="20" r="2" fill="var(--sw-fg-1)"></circle>
</svg>
