{
  "name": "{{name}}",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/app.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "start": "pnpm build && electron ."
  },
  "dependencies": {
    "@sewed/react": "{{version}}",
    "effect": "4.0.0-rc.112",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sewed": "{{version}}"
  },
  "devDependencies": {
    "@sewed/vite": "{{version}}",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.3.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
