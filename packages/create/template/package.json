{
  "name": "{{name}}",
  "version": "0.0.0",
  "private": true,
  "description": "An Electron application built with Sewed.",
  "type": "module",
  "main": "dist/main/app.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "start": "pnpm build && electron .",
    "prepare": "effect-tsgo patch --typescript --no-oxlint"
  },
  "dependencies": {
    "@sewed/react": "{{version}}",
    "effect": "4.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sewed": "{{version}}"
  },
  "devDependencies": {
    "@effect/tsgo": "0.51.1",
    "@sewed/vite": "{{version}}",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
