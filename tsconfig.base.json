{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "ES2024.String", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "includeSuggestionsInTsc": false,
        "allowedUnstableApis": ["effect/rpc", "effect/http", "effect/devtools"],
        "overrides": [
          {
            "include": ["**/src/**/*.ts"],
            "options": { "diagnosticSeverity": { "floatingEffect": "error" } }
          },
          {
            "include": ["**/test/**/*.ts", "**/test/**/*.tsx"],
            "options": {
              "diagnosticSeverity": {
                "globalErrorInEffectFailure": "suggestion"
              }
            }
          },
          {
            "include": ["**/test/**/types.ts", "**/test/**/*-types.ts"],
            "options": {
              "diagnosticSeverity": {
                "floatingEffect": "off",
                "missingEffectContext": "off",
                "missingEffectError": "off",
                "missingLayerContext": "off",
                "missingReturnYieldStar": "off"
              }
            }
          }
        ]
      }
    ]
  }
}
